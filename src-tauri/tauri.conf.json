{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beatmaps Starter",
  "version": "0.1.3",
  "identifier": "app.beatmaps.starter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beatmaps Starter",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 590,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4Mjc3MTAwMDBDNjhDODQKUldTRWpNWUFBSEVuT0FOcGM4RFI2bWJBdmJZd29WUEdYUmVUN2VOUE9OcXV2eDRNS3UzSmdyaEQK",
      "endpoints": [
        "https://github.com/hikarin31768/beatmaps-starter/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "languages": ["SimpChinese"], "installMode": "currentUser", "compression": "zlib" }
    }
  }
}
